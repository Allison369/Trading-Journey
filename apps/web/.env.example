# ---------------------------------------------------------------------------
# TradeVault web app — environment
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the two values from your own
# Supabase project (Project Settings -> API).
#
#   cp .env.example .env.local
#
# ---------------------------------------------------------------------------
# ARE THESE SECRETS?
# ---------------------------------------------------------------------------
# No — and it matters that you understand why, because it changes what protects
# your data.
#
# VITE_-prefixed variables are inlined into the JavaScript bundle at build
# time. Anyone who opens the deployed site can read them. They are therefore
# public by definition.
#
# Your data is protected by Row Level Security in the database (see
# supabase/migrations/0002_rls_policies.sql), NOT by hiding this key. The anon
# key only ever lets a request act as a signed-in user, and every policy scopes
# rows to that user. That is the whole point of RLS.
#
# NEVER put either of these in a VITE_ variable, and never commit them:
#   * the service_role key         — bypasses ALL Row Level Security
#   * your database password       — grants direct access to PostgreSQL
#   * your JWT secret              — lets anyone mint valid tokens
#
# If you ever paste a service_role key into a front-end env file, treat it as
# compromised and rotate it immediately in the Supabase dashboard.
# ---------------------------------------------------------------------------

# Your project URL, e.g. https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=

# Your project's anon (public) key. Safe to expose; RLS does the enforcing.
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Optional: run the app without Supabase, using browser-local storage only.
# ---------------------------------------------------------------------------
# Set to `true` to use the offline demo store. Handy for evaluating the UI, and
# for the preview build. Data stays in this browser and never leaves it. The
# app labels itself clearly when it is in this mode.
VITE_OFFLINE_DEMO=false
