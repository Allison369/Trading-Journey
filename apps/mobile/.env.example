# TradeVault mobile — environment
#
# Copy to `.env` and fill in the same project you use for the web app. The
# mobile app reads these through `expo-constants` (app.json -> extra).
#
# Only the anon key belongs here. The service-role key bypasses Row Level
# Security and must never be embedded in a shipped app bundle.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
